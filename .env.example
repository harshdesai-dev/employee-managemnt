# Local development. Generate SESSION_SECRET with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NODE_ENV=development
PORT=4000
CLIENT_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://peopleos:replace-this-local-password@localhost:5432/peopleos
POSTGRES_PASSWORD=replace-this-local-password
DB_SSL=false
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
SESSION_SAME_SITE=lax
SESSION_MAX_AGE_MS=28800000
ADMIN_NAME=PeopleOS Administrator
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
